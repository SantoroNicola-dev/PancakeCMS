generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  READER
}

enum PostType {
  POST
  PAGE
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  APPROVED
  PENDING
  SPAM
  REJECTED
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String
  role             Role           @default(READER)
  bio              String?
  avatarUrl        String?
  jobTitle         String?
  isActive         Boolean        @default(true)
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?
  backupCodes      String?        // JSON array of backup codes
  forceTwoFactor   Boolean        @default(false)
  oauthProvider    String?
  lastLoginAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  posts            Post[]         @relation("AuthorPosts")
  revisions        PostRevision[]
  comments         Comment[]
  likes            PostLike[]
  bookmarks        Bookmark[]
  mediaUploads     Media[]
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  color          String     @default("#c54c3d")
  parentId       String?
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryHierarchy")
  seoTitle       String?
  seoDescription String?
  order          Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  posts          Post[]
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#64748b")
  isInternal  Boolean  @default(false) // true = Tag Interno Editoriale (es. #evidenza, #sponsorizzato)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]   @relation("PostTags")
}

model Post {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String?
  content        String         // Rich HTML generated by Tiptap WYSIWYG
  coverImage     String?
  coverImageAlt  String?
  type           PostType       @default(POST)
  status         PostStatus     @default(DRAFT)
  featured       Boolean        @default(false)
  allowComments  Boolean        @default(true)
  readingTimeMin Int            @default(1)
  viewsCount     Int            @default(0)
  publishedAt    DateTime?
  scheduledFor   DateTime?

  // Relazioni Autore & Tassonomia
  authorId       String
  author         User           @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           Tag[]          @relation("PostTags")

  // Suite SEO Metadati
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  noIndex        Boolean        @default(false)
  noFollow       Boolean        @default(false)
  schemaType     String         @default("BlogPosting") // BlogPosting, Article, NewsArticle, WebPage
  seoScore       Int            @default(0)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  revisions      PostRevision[]
  comments       Comment[]
  likes          PostLike[]
  bookmarks      Bookmark[]

  @@index([status, type, publishedAt])
  @@index([slug])
}

model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  excerpt   String?
  content   String
  note      String?
  createdAt DateTime @default(now())
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  folder       String   @default("Generale")
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String   @default("")
  title        String   @default("")
  caption      String   @default("")
  focalPointX  Float    @default(50)
  focalPointY  Float    @default(50)
  fileData     Bytes?   // Binary backup in PostgreSQL so uploads survive container rebuilds
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Comment {
  id           String        @id @default(cuid())
  postId       String
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("CommentReplies")
  content      String
  status       CommentStatus @default(APPROVED)
  likesCount   Int           @default(0)
  flaggedCount Int           @default(0)
  isPinned     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([postId, status])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Redirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  statusCode      Int      @default(301)
  isActive        Boolean  @default(true)
  hits            Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                      String   @id @default("default")
  siteName                String   @default("Il Blog di Sara")
  siteTagline             String   @default("Storie, riflessioni, design e cultura digitale raccontati con cura editoriale.")
  siteDescription         String   @default("Un magazine indipendente dedicato a creatività, scrittura, lifestyle consapevole e cultura contemporanea.")
  siteUrl                 String   @default("http://localhost:3000")
  // Identità Visiva, Loghi & Brand
  logoText                String   @default("Sara.")
  logoType                String   @default("text") // "text" | "image" | "both"
  logoImageUrl            String   @default("")
  logoDarkImageUrl        String   @default("")
  logoHeight              Int      @default(36)
  faviconUrl              String   @default("")
  showSiteNameInNavbar    Boolean  @default(true)
  mastheadBadge           String   @default("Magazine Indipendente")
  showMasthead            Boolean  @default(true)

  // Tema, Palette Colori & Superfici (Light & Dark)
  themePreset             String   @default("terracotta")
  defaultThemeMode        String   @default("system") // "system" | "light" | "dark"
  allowThemeToggle        Boolean  @default(true)
  primaryColor            String   @default("#c54c3d")
  accentColor             String   @default("#1e293b")
  bgLightColor            String   @default("#ffffff")
  surfaceLightColor       String   @default("#ffffff")
  textLightColor          String   @default("#0f172a")
  bgDarkColor             String   @default("#020617")
  surfaceDarkColor        String   @default("#0f172a")
  textDarkColor           String   @default("#f1f5f9")

  // Tipografia & Stile Testo
  fontPairing             String   @default("editorial") // legacy compatibility
  headingFont             String   @default("Georgia")
  bodyFont                String   @default("Inter")
  baseFontSize            Int      @default(16)
  articleLineHeight       String   @default("relaxed") // "compact" | "relaxed" | "loose"
  headingTracking         String   @default("tight")   // "tighter" | "tight" | "normal" | "wide"

  // Layout Globale, Header, Home & Sidebar
  navbarStyle             String   @default("classic")  // "classic" | "centered" | "minimal" | "floating"
  stickyNavbar            Boolean  @default(true)
  containerWidth          String   @default("standard") // "compact" | "standard" | "wide"
  heroLayout              String   @default("magazine") // "magazine" | "spotlight" | "minimal" | "dual" | "none"
  postsGridLayout         String   @default("grid-2")   // "grid-2" | "grid-3" | "list" | "magazine-mix"
  postsPerPage            Int      @default(9)
  sidebarPosition         String   @default("right")    // "right" | "left" | "none"
  showCategoryBar         Boolean  @default(true)
  showMostReadWidget      Boolean  @default(true)
  showTagsWidget          Boolean  @default(true)
  showAuthorWidget        Boolean  @default(true)
  authorWidgetTitle       String   @default("Chi scrive qui")
  authorWidgetBio         String   @default("Uno spazio indipendente dedicato a scrittura digitale, cultura visiva e slow living.")
  authorWidgetImage       String   @default("")

  // Stile Card, Bordi & Componenti UI
  borderRadiusStyle       String   @default("rounded")  // "sharp" | "subtle" | "rounded" | "pill"
  cardStyle               String   @default("bordered") // "bordered" | "elevated" | "flat" | "glass"
  cardImageRatio          String   @default("video")    // "video" | "classic" | "square" | "portrait"
  showCardExcerpt         Boolean  @default(true)
  showCardAuthor          Boolean  @default(true)
  showCardDate            Boolean  @default(true)
  showCardCategory        Boolean  @default(true)
  showCardStats           Boolean  @default(true)
  buttonStyle             String   @default("pill")     // "sharp" | "rounded" | "pill"

  // Layout Pagina Singolo Articolo
  articleWidth            String   @default("normal")   // "narrow" | "normal" | "wide"
  articleHeaderStyle      String   @default("classic")  // "classic" | "centered" | "cover-overlay"
  showReadingProgress     Boolean  @default(true)
  showArticleToc          Boolean  @default(true)
  showAuthorBioCard       Boolean  @default(true)
  showRelatedPosts        Boolean  @default(true)

  // Top Announcement Bar
  enableAnnouncementBar   Boolean  @default(false)
  announcementText        String   @default("✨ Nuovo numero della newsletter disponibile ogni venerdì!")
  announcementLinkText    String   @default("Iscriviti ora")
  announcementLinkUrl     String   @default("#newsletter")
  announcementBgColor     String   @default("#c54c3d")
  announcementTextColor   String   @default("#ffffff")

  // Footer & Newsletter Box
  footerStyle             String   @default("editorial") // "editorial" | "minimal" | "centered"
  showFooterNewsletter    Boolean  @default(true)
  newsletterBadge         String   @default("La Lettera del Venerdì")
  newsletterTitle         String   @default("Ricevi i nuovi articoli e i consigli di lettura nella tua casella email")
  newsletterDescription   String   @default("Zero spam, nessun algoritmo. Solo saggi curati, note di design e letture scelte una volta a settimana.")
  newsletterButtonText    String   @default("Iscriviti gratuitamente")
  footerCopyrightText     String   @default("Tutti i diritti riservati. Realizzato con cura editoriale.")

  // CSS Personalizzato Avanzato
  customCss               String   @default("")

  // SEO Globale
  defaultMetaTitleTemplate String  @default("%s | Il Blog di Sara")
  defaultOgImage           String  @default("/uploads/demo-hero-editorial.webp")
  robotsTxtContent         String  @default("User-agent: *\nAllow: /\nDisallow: /admin/\nDisallow: /api/")
  enableIndexing           Boolean @default(true)

  // Google Analytics 4, GTM & Tag Manager
  gaMeasurementId          String  @default("") // es. G-XXXXXXXXXX
  gtmContainerId           String  @default("") // es. GTM-XXXXXXX
  enableGa4                Boolean @default(false)
  trackScrollDepth         Boolean @default(true)
  trackArticleRead         Boolean @default(true)
  trackOutboundLinks       Boolean @default(true)
  customHeadScripts        String  @default("")
  customBodyScripts        String  @default("")

  // Cookie Consent GDPR (Consent Mode v2)
  enableCookieBanner       Boolean @default(true)
  cookieBannerTitle        String  @default("Rispettiamo la tua privacy")
  cookieBannerText         String  @default("Utilizziamo cookie tecnici e, previo tuo consenso, cookie analitici (Google Analytics 4 con IP anonimizzato e Consent Mode v2) per comprendere quali articoli sono più apprezzati.")
  privacyPolicyUrl         String  @default("/pagina/privacy-policy")

  // Moderazione & Sicurezza
  commentModeration        String  @default("auto") // "auto" (pubblica subito per registrati, filtra spam) | "manual" (approvazione preventiva)
  profanityFilterWords     String  @default("spam,casino,crypto-scam,viagra")
  forceStaffTwoFactor      Boolean @default(false)
  allowRegistration        Boolean @default(true)

  // Menu Builder & Social JSON
  headerMenuJson           String  @default("[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"Editoriali\",\"href\":\"/categoria/editoriali\"},{\"label\":\"Cultura & Libri\",\"href\":\"/categoria/cultura-libri\"},{\"label\":\"Lifestyle\",\"href\":\"/categoria/lifestyle\"},{\"label\":\"Chi Sono\",\"href\":\"/pagina/chi-sono\"}]")
  footerMenuJson           String  @default("[{\"label\":\"Chi Sono\",\"href\":\"/pagina/chi-sono\"},{\"label\":\"Privacy & Cookie\",\"href\":\"/pagina/privacy-policy\"},{\"label\":\"Feed RSS\",\"href\":\"/feed.xml\"}]")
  socialLinksJson          String  @default("{\"instagram\":\"https://instagram.com\",\"linkedin\":\"https://linkedin.com\",\"newsletter\":\"#newsletter\"}")

  updatedAt                DateTime @updatedAt
}
